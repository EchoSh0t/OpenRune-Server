# Copy to .env.local and fill in.

# Game server website API (content/other/website-api). Server-side only - never exposed to browsers.
# The key is generated on first server start in .data/website-api.properties (api_key=...).
GAME_API_URL=http://127.0.0.1:8091
GAME_API_KEY=

# Branding and links shown on the site.
NEXT_PUBLIC_SERVER_NAME=Elysium
NEXT_PUBLIC_DISCORD_URL=

# Client download links on the Play page. Empty entries show "Coming soon".
NEXT_PUBLIC_DOWNLOAD_WINDOWS_URL=
NEXT_PUBLIC_DOWNLOAD_MACOS_URL=
NEXT_PUBLIC_DOWNLOAD_LINUX_URL=
NEXT_PUBLIC_DOWNLOAD_JAR_URL=

# Optional Cloudflare Turnstile captcha on the register form. Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin area (/admin) talks to the game server admin API (localhost only).
# Copy api_key from .data/web-panel.properties after the first server start.
ADMIN_API_URL=http://127.0.0.1:8090
ADMIN_API_KEY=

# Public address of this site, e.g. https://elysium.example. Used for Discord redirects and news links.
# Leave empty locally to use whatever address the browser is on.
SITE_URL=

# Optional "Link Discord" button on the account page. Create an application at
# https://discord.com/developers/applications and add <SITE_URL>/account/discord/callback as a redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Channel webhook used by `npm run announce -- <news-slug>` to post news to Discord.
DISCORD_NEWS_WEBHOOK_URL=

# Where the changelog page reads from. Defaults to ../CHANGELOG.md (the repo root).
CHANGELOG_PATH=
